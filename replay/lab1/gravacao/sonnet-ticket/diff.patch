+def cancelar(db: Session, pedido_id: int) -> Pedido:
+    """Cancela o pedido e devolve os itens ao estoque. Cancelar de novo não devolve outra vez."""
+    pedido = obter(db, pedido_id)
+    if pedido.status == "CANCELADO":
+        return pedido
+    if pedido.fatura or pedido.status == "FATURADO":
+        raise RegraDeNegocio("Pedido faturado não pode ser cancelado (estorno é outro processo)", status=409)
+
+    for item in pedido.itens:
+        estoque = db.query(Estoque).filter(Estoque.produto_id == item.produto_id).first()
+        if estoque:
+            estoque.quantidade += item.quantidade
+    pedido.status = "CANCELADO"
+    db.commit()
+    db.refresh(pedido)
+    return pedido
