+
+def cancelar(db: Session, pedido_id: int) -> Pedido:
+    """Cancela um pedido e devolve estoque se ainda não foi faturado."""
+    pedido = obter(db, pedido_id)
+
+    if pedido.fatura:
+        raise RegraDeNegocio("Pedido faturado não pode ser cancelado", status=409)
+
+    if pedido.status == "CANCELADO":
+        return pedido
+
+    for item in pedido.itens:
+        estoque = db.query(Estoque).filter(Estoque.produto_id == item.produto_id).first()
+        estoque.quantidade += item.quantidade
+
+    pedido.status = "CANCELADO"
+    db.commit()
+    db.refresh(pedido)
+    return pedido
+
