{
  "name": "fiap-ea-genai-lab",
  "build": { "dockerfile": "Dockerfile" },
  "hostRequirements": { "cpus": 2 },
  "features": {
    "ghcr.io/devcontainers/features/node:2": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code"
  ],
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "onCreateCommand": "uv sync --frozen && npm install -g @openai/codex @modelcontextprotocol/inspector",
  "postCreateCommand": "make check",
  "forwardPorts": [8000, 6274, 6275, 6278],
  "portsAttributes": {
    "8000": { "label": "Mini-ERP" },
    "6274": { "label": "MCP Inspector" },
    "6275": { "label": "MCP Inspector (sandbox)" },
    "6278": { "label": "MCP Inspector (apps)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" }
    }
  }
}
